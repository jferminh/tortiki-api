@startuml Slide3_Interaction_Tortiki
skinparam pageWidth 340mm
skinparam pageMargin 5
skinparam dpi 150
scale max 1280 width

skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 17
skinparam packageStyle rectangle
skinparam shadowing false

skinparam component {
  BackgroundColor #EEF6FB
  BorderColor #1B6FA8
  FontColor #1B3A4B
  FontSize 17
}
skinparam package {
  BackgroundColor #FBFBFB
  BorderColor #888888
  FontStyle bold
  FontSize 20
}
skinparam actor {
  BackgroundColor #FDEDEC
  BorderColor #C0392B
  FontSize 17
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #C7A600
  FontSize 15
}

title Interaction tortiki-frontend ↔ tortiki-api (3/3)

actor "Sofia / Théo" as User

package "tortiki-frontend" as FRONT #E8F0FE {
  [Controllers\nMVC] as Ctrl
  [ApiDelegating\nAuthenticationProvider] as AuthProvider
  [FeignConfig +\nFeign Clients] as FeignClients
}

package "tortiki-api" as API #E8F5E9 {
  [Controllers\nREST] as CtrlWeb
  [Services +\nDomaine] as Core
}

User --> Ctrl : HTTP\n(cookie JSESSIONID frontend)
Ctrl --> FeignClients : délègue
AuthProvider --> CtrlWeb : login()
FeignClients --> CtrlWeb : requêtes REST\n(Cookie API propagé)
CtrlWeb --> Core : traite

note bottom of AuthProvider
  1. Login → AuthApiClient.login()
  2. Récupère Set-Cookie de l'API
  3. Stocke en session frontend
  4. FeignConfig relit ce cookie
     à chaque appel sortant
end note

@enduml