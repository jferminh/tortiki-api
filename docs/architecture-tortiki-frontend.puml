@startuml Slide1_Frontend_Tortiki
skinparam pageWidth 340mm
skinparam pageMargin 5
skinparam dpi 150
scale max 1280 width

skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 16
skinparam packageStyle rectangle
skinparam shadowing false

skinparam component {
  BackgroundColor #EEF6FB
  BorderColor #1B6FA8
  FontColor #1B3A4B
  FontSize 16
}
skinparam package {
  BackgroundColor #FBFBFB
  BorderColor #888888
  FontStyle bold
  FontSize 18
}
skinparam actor {
  BackgroundColor #FDEDEC
  BorderColor #C0392B
  FontSize 16
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #C7A600
  FontSize 14
}

title tortiki-frontend — MVC / SOLID (1/3)

actor "Sofia / Théo\n(navigateur)" as User

package "controller" as CTRL #FFF3E0 {
  [HomeController\nSearchController\nDashboardController\nAdminController...] as Ctrl
}

package "config.security" as SEC #FDEBD0 {
  [SecurityConfig] as SecCfg
  [ApiDelegatingAuthenticationProvider] as AuthProvider
}

package "client" as CLIENT #EEF6FB {
  [Feign Clients\n(Auth, Listing, Search,\nContact, Admin...)] as FeignClients
}

package "config" as CFG #FDEBD0 {
  [FeignConfig\n(intercepteur cookie API)] as FeignCfg
}

[templates Thymeleaf\n(vues SSR Bootstrap 5)] as Views

User --> Ctrl : requête HTTP
Ctrl --> FeignClients : appelle
Ctrl --> Views : résout
SecCfg --> AuthProvider : délègue authenticate()
AuthProvider --> FeignClients : login()
FeignCfg ..> FeignClients : intercepte

note bottom of Ctrl
  Le contrôleur dépend uniquement
  d'interfaces Feign (DIP).
  Il retourne une vue Thymeleaf,
  jamais du JSON.
end note

@enduml