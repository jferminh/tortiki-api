@startuml Tortiki_MCD
!theme plain
skinparam linetype ortho
skinparam backgroundColor #FAFAF8
skinparam entity {
  BackgroundColor #F0F4F8
  BorderColor #2D6A6F
  FontColor #1A1A1A
  FontName Arial
  FontSize 13
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}

title Modèle Conceptuel de Données — Tortiki MVP\n<size:11>Architecture Hexagonale · PostgreSQL 16 · Flyway V1</size>

' ========================
' ENTITÉS
' ========================

entity "**USER**" as USER {
  * id : BIGSERIAL <<PK>>
  --
  * email : VARCHAR(255) <<UNIQUE>>
  * password_hash : VARCHAR(255)
  * first_name : VARCHAR(100)
  * last_name : VARCHAR(100)
  phone : VARCHAR(20)
  avatar_url : VARCHAR(500)
  city : VARCHAR(100)
  latitude : NUMERIC(10,7)
  longitude : NUMERIC(10,7)
  * enabled : BOOLEAN = true
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "**ROLE**" as ROLE {
  * id : BIGSERIAL <<PK>>
  --
  * name : VARCHAR(50) <<UNIQUE>>
  .. ex: ROLE_ADMIN, ROLE_SELLER, ROLE_BUYER ..
}

entity "**USER_ROLES**\n(table d'association)" as USER_ROLES {
  * user_id : BIGINT <<FK>>
  * role_id : BIGINT <<FK>>
}

entity "**LISTING**" as LISTING {
  * id : BIGSERIAL <<PK>>
  --
  * seller_id : BIGINT <<FK>>
  * cuisine_type_id : BIGINT <<FK>>
  * title : VARCHAR(255)
  description : TEXT
  * price : NUMERIC(10,2) > 0
  * portions : INTEGER > 0
  photo_url : VARCHAR(500)
  * pickup_address : VARCHAR(255)
  pickup_lat : NUMERIC(10,7)
  pickup_lng : NUMERIC(10,7)
  * pickup_datetime : TIMESTAMP
  * status : listing_status
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "**CUISINE_TYPE**" as CUISINE_TYPE {
  * id : BIGSERIAL <<PK>>
  --
  * name : VARCHAR(100) <<UNIQUE>>
  description : TEXT
  * enabled : BOOLEAN = true
}

entity "**ALLERGEN**" as ALLERGEN {
  * id : BIGSERIAL <<PK>>
  --
  * name : VARCHAR(100) <<UNIQUE>>
  .. 14 allergènes réglementaires EU ..
}

entity "**LISTING_ALLERGENS**\n(table d'association)" as LISTING_ALLERGENS {
  * listing_id : BIGINT <<FK>>
  * allergen_id : BIGINT <<FK>>
}

entity "**CONTACT_REQUEST**" as CONTACT_REQUEST {
  * id : BIGSERIAL <<PK>>
  --
  * listing_id : BIGINT <<FK>>
  * buyer_id : BIGINT <<FK>>
  * portions : INTEGER > 0
  * status : contact_request_status
  message : TEXT
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  --
  <<UNIQUE(listing_id, buyer_id)>>
}

entity "**REVIEW**" as REVIEW {
  * id : BIGSERIAL <<PK>>
  --
  * contact_request_id : BIGINT <<FK>> <<UNIQUE>>
  * reviewer_id : BIGINT <<FK>>
  * seller_id : BIGINT <<FK>>
  * listing_id : BIGINT <<FK>>
  * rating : SMALLINT [1..5]
  comment : TEXT
  * created_at : TIMESTAMP
}

' ========================
' TYPES ÉNUMÉRÉS
' ========================

note bottom of LISTING
  <b>listing_status</b>
  ACTIVE | INACTIVE | DELETED
end note

note bottom of CONTACT_REQUEST
  <b>contact_request_status</b>
  PENDING | CONFIRMED | REFUSED
end note

' ========================
' RELATIONS
' ========================

USER ||--o{ USER_ROLES : "possède"
ROLE ||--o{ USER_ROLES : "attribué à"

USER ||--o{ LISTING : "publie\n(seller_id)"
CUISINE_TYPE ||--o{ LISTING : "catégorise"

LISTING ||--o{ LISTING_ALLERGENS : "contient"
ALLERGEN ||--o{ LISTING_ALLERGENS : "présent dans"

LISTING ||--o{ CONTACT_REQUEST : "reçoit"
USER ||--o{ CONTACT_REQUEST : "envoie\n(buyer_id)"

CONTACT_REQUEST ||--o| REVIEW : "génère\n(1 max)"
USER ||--o{ REVIEW : "rédige\n(reviewer_id)"
USER ||--o{ REVIEW : "reçoit\n(seller_id)"
LISTING ||--o{ REVIEW : "associée à"

@enduml