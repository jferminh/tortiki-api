@startuml MCD_Tortiki
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #EEF6FB
  BorderColor #1B6FA8
  FontColor #1B3A4B
  ArrowColor #1B6FA8
  FontSize 12
}
title Modèle Conceptuel de Données — Tortiki

entity "User" as User {
  * id : BIGINT <<PK>>
  --
  email : VARCHAR
  password_hash : VARCHAR
  phone : VARCHAR
  city : VARCHAR
  latitude : NUMERIC(10,7)
  longitude : NUMERIC(10,7)
  enabled : BOOLEAN
}

entity "Role" as Role {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR
}

entity "user_roles" as UserRoles {
  * user_id : BIGINT <<FK>>
  * role_id : BIGINT <<FK>>
}

entity "Listing" as Listing {
  * id : BIGINT <<PK>>
  --
  title : VARCHAR
  price : NUMERIC
  portions : INTEGER
  pickup_datetime : TIMESTAMP
  status : listing_status
  seller_id : BIGINT <<FK>>
  cuisine_type_id : BIGINT <<FK>>
}

entity "CuisineType" as CuisineType {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR
}

entity "Allergen" as Allergen {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR
}

entity "listing_allergens" as ListingAllergens {
  * listing_id : BIGINT <<FK>>
  * allergen_id : BIGINT <<FK>>
}

entity "ContactRequest" as ContactRequest {
  * id : BIGINT <<PK>>
  --
  listing_id : BIGINT <<FK>>
  buyer_id : BIGINT <<FK>>
  status : contact_request_status
  message : TEXT
  portions : INTEGER
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
  ..
  <<UNIQUE(listing_id, buyer_id)>>
}

entity "Review" as Review {
  * id : BIGINT <<PK>>
  --
  contact_request_id : BIGINT <<FK>>
  reviewer_id : BIGINT <<FK>>
  listing_id : BIGINT <<FK>>
  rating : INTEGER
  comment : TEXT
  created_at : TIMESTAMP
}

User "1" -- "0..*" Listing : publie (seller)
User "1" -- "0..*" UserRoles
Role "1" -- "0..*" UserRoles
Listing "1" -- "0..*" ListingAllergens
Allergen "1" -- "0..*" ListingAllergens
CuisineType "1" -- "0..*" Listing
Listing "1" -- "0..*" ContactRequest
User "1" -- "0..*" ContactRequest : soumet (buyer)
ContactRequest "1" -- "0..1" Review : génère
User "1" -- "0..*" Review : rédige
Listing "1" -- "0..*" Review : concerne

@enduml