ListingService --> StoragePort

CuisineTypeService ..|> ManageCuisineTypeUseCase
CuisineTypeService --> CuisineTypeRepository

ContactRequestService ..|> ManageContactRequestUseCase
ContactRequestService --> ContactRequestRepository
ContactRequestService --> EmailPort

ReviewService ..|> ManageReviewUseCase
ReviewService --> ReviewRepository

AuthController --> RegisterUserUseCase
AuthController --> FindUserUseCase
ListingController --> ManageListingUseCase
CuisineTypeController --> ManageCuisineTypeUseCase
ContactRequestController --> ManageContactRequestUseCase

ListingRepositoryAdapter ..|> ListingRepository
CuisineTypeRepositoryAdapter ..|> CuisineTypeRepository
ContactRequestRepositoryAdapter ..|> ContactRequestRepository
