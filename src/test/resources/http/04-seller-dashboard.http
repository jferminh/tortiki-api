Content-Type: application/json

{
  "email": "{{theoEmail}}",
  "password": "{{password}}"
}

###

### [15bis] Demande de Théo sur la 2e annonce → 201 PENDING
POST {{baseUrl}}/api/v1/contact-requests
Content-Type: application/json

{
  "listingId": {{listing2Id}},
  "message": "3 portions de vareniký svp !",
  "portions": 3
}

> {%
    client.test("Demande sur 2e annonce → 201 PENDING", function() {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.global.set("contactRequest2Id", String(response.body.id));
    });
%}

