###

### [14bis] 2e annonce Sofia → 201 Created
POST {{baseUrl}}/api/v1/listings
Content-Type: application/json

{
  "title": "Vareniký au fromage blanc",
  "description": "Raviolis ukrainiens farcis au fromage frais.",
  "price": 7.00,
  "portions": 6,
  "cuisineTypeId": 1,
  "allergenIds": [],
  "pickupAddress": "12 rue de la Paix, 54000 Nancy",
  "pickupDatetime": "2026-07-12T12:00:00"
}

> {%
    client.test("2e annonce Sofia → 201", function() {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.global.set("listing2Id", String(response.body.id));
    });
%}

###

### [15] Login Théo — soumettre demande sur 2e annonce
