### ── ISSUE 44 — PATCH statut ────────────────────────────────────

### [6] Login Sofia — SELLER
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{sofiaEmail}}",
  "password": "{{password}}"
}

###

### [7] Sofia CONFIRME la demande → 200 OK — CONFIRMED
PATCH {{baseUrl}}/api/v1/seller-dashboard/contact-requests/{{contactRequestId}}/status
Content-Type: application/json

{
  "newStatus": "CONFIRMED"
}

> {%
    client.test("Confirmer demande → 200 CONFIRMED", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.status === "CONFIRMED", "Statut attendu : CONFIRMED");
    });
%}

###

### [8] Sofia re-confirme → 409 Conflict (statut final irréversible)
PATCH {{baseUrl}}/api/v1/seller-dashboard/contact-requests/{{contactRequestId}}/status
Content-Type: application/json

{
  "newStatus": "CONFIRMED"
}

> {%
    client.test("Statut final irréversible → 409 Conflict", function() {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
    });
%}

###

### [9] newStatus null → 400 Bad Request (@NotNull)
PATCH {{baseUrl}}/api/v1/seller-dashboard/contact-requests/{{contactRequestId}}/status
Content-Type: application/json

{
  "newStatus": null
}

> {%
    client.test("newStatus null → 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}

###

### [10] Demande inexistante → 404 Not Found
PATCH {{baseUrl}}/api/v1/seller-dashboard/contact-requests/999999/status
Content-Type: application/json

{
  "newStatus": "CONFIRMED"
}

> {%
    client.test("Demande inexistante → 404 Not Found", function() {
        client.assert(response.status === 404, "Expected 404, got " + response.status);
    });
%}

