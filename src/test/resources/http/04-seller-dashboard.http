### ── ISSUE 43 — Dashboard vendeur ──────────────────────────────

### [1] Login Sofia — SELLER
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{sofiaEmail}}",
  "password": "{{password}}"
}

###

### [2] Sofia consulte son dashboard → 200 OK (liste PENDING)
GET {{baseUrl}}/api/v1/seller-dashboard/contact-requests

> {%
    client.test("Dashboard vendeur → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(Array.isArray(response.body), "Réponse doit être un tableau");
        client.assert(response.body.length > 0, "Au moins 1 demande attendue");
        client.assert(response.body[0].status === "PENDING", "Statut attendu : PENDING");
    });
%}

###

### [3] Login Théo — BUYER
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{theoEmail}}",
  "password": "{{password}}"
}

###

### [4] BUYER accède au dashboard vendeur → 403 Forbidden
GET {{baseUrl}}/api/v1/seller-dashboard/contact-requests

> {%
    client.test("BUYER dashboard vendeur → 403 Forbidden", function() {
        client.assert(response.status === 403, "Expected 403, got " + response.status);
    });
%}

###

### [5] Sans authentification → 401 Unauthorized
GET {{baseUrl}}/api/v1/seller-dashboard/contact-requests

> {%
    client.test("Dashboard sans auth → 401 Unauthorized", function() {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

