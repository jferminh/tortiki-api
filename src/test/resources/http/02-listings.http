### =============================================================
### TORTIKI — Listings (Sprint 1)
### POST   /api/v1/listings        → 201 (ROLE_SELLER)
### GET    /api/v1/listings/search → 200 (public)
### GET    /api/v1/listings/{id}   → 200 (public)
### PUT    /api/v1/listings/{id}   → 200 (ROLE_SELLER)
### =============================================================

### [1] Login Sofia — SELLER
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{sofiaEmail}}",
  "password": "{{password}}"
}

###

### [2] Sofia crée une annonce — Bortsch (201 Created)
POST {{baseUrl}}/api/v1/listings
Content-Type: application/json

{
  "title": "Bortsch ukrainien maison",
  "description": "Soupe traditionnelle ukrainienne, recette de ma grand-mère",
  "price": 8.50,
  "portions": 4,
  "cuisineTypeId": 1,
  "allergenIds": [],
  "pickupAddress": "2 Allée Lys Rouge, 54000 Nancy",
  "pickupDatetime": "2026-06-28T12:00:00"
}

> {%
    client.test("Créer annonce → 201 ACTIVE", function() {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        const body = response.body;
        client.assert(body["status"] === "ACTIVE", "Statut attendu : ACTIVE");
        client.global.set("listingId", String(body["id"]));
    });
%}

###

### [3] Recherche publique — sans auth (200 OK)
GET {{baseUrl}}/api/v1/listings/search?city=Nancy&page=0&size=10

> {%
    client.test("Recherche publique → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

###

### [4] Détail annonce par ID — public
GET {{baseUrl}}/api/v1/listings/{{listingId}}

> {%
    client.test("Détail annonce → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

###

### [5] Annonce inexistante → 404
GET {{baseUrl}}/api/v1/listings/999999

> {%
    client.test("Annonce inexistante → 404", function() {
        client.assert(response.status === 404, "Expected 404, got " + response.status);
    });
%}

###

### [6] Login Théo — BUYER
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{theoEmail}}",
  "password": "{{password}}"
}

###

### [7] BUYER tente de créer une annonce → 403
POST {{baseUrl}}/api/v1/listings
Content-Type: application/json

{
  "title": "Tentative BUYER",
  "description": "Ne doit pas passer.",
  "price": 5.00,
  "portions": 2,
  "cuisineTypeId": 1,
  "allergenIds": [],
  "pickupAddress": "2 Allée Lys Rouge, 54000 Nancy",
  "pickupDatetime": "2026-06-28T12:00:00"
}

> {%
    client.test("BUYER crée annonce → 403 Forbidden", function() {
        client.assert(response.status === 403, "Expected 403, got " + response.status);
    });
%}

###

### [8] Login Sofia
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{sofiaEmail}}",
  "password": "{{password}}"
}

###

### [9] Sofia modifie son annonce → 200 OK
PUT {{baseUrl}}/api/v1/listings/{{listingId}}
Content-Type: application/json

{
  "title": "Bortsch ukrainien maison — édition été",
  "description": "Recette estivale avec ingrédients frais du marché.",
  "price": 9.50,
  "portions": 4,
  "cuisineTypeId": 1,
  "allergenIds": [],
  "pickupAddress": "2 Allée Lys Rouge, 54000 Nancy",
  "pickupDatetime": "2026-07-15T12:00:00"
}

> {%
    client.test("Modifier annonce → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        const body = response.body;
        client.assert(body["price"] === 9.50, "Prix attendu : 9.50");
    });
%}