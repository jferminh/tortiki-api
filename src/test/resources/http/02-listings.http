### [12] Sofia modifie son annonce avec une NOUVELLE VILLE (Nancy → Strasbourg)
### Vérifie le re-géocodage sur update() : city doit changer, pas seulement lat/lng.
PUT {{baseUrl}}/api/v1/listings/7
Content-Type: application/json

{
  "title": "Bortsch ukrainien maison — édition été",
  "description": "Recette estivale avec ingrédients frais du marché.",
  "price": 9.50,
  "portions": 4,
  "cuisineTypeId": 1,
  "allergenIds": [],
  "pickupAddress": "1 place Kléber, 67000 Strasbourg",
  "pickupDatetime": "2027-04-20T12:00:00"
}

> {%
    client.test("Modifier annonce avec nouvelle adresse → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        const body = response.body;
        client.assert(body["price"] === 9.50, "Prix attendu : 9.50");
    });
%}

###

### [13] La ville a bien changé après modification (re-géocodage confirmé)
GET {{baseUrl}}/api/v1/listings/cities

> {%
    client.test("Autocomplétion → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("'Strasbourg' présente, 'Nancy' disparue — re-géocodage effectif sur update", function() {
        const cities = response.body;
        client.assert(cities.includes("Strasbourg"),
            "Strasbourg doit apparaître après modification, reçu : " + JSON.stringify(cities));
        client.assert(!cities.includes("Nancy"),
            "Nancy ne doit plus apparaître, l'annonce a changé de ville, reçu : " + JSON.stringify(cities));
    });
%}

###

### [14] Sofia consulte son dashboard — l'annonce ACTIVE apparaît (200 OK)
GET {{baseUrl}}/api/v1/seller-listings

> {%
    client.test("Dashboard vendeur → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Annonce présente dans le dashboard", function() {
        const body = response.body;
        const found = body.some(l => String(l["id"]) === client.global.get("listingId"));
        client.assert(found, "L'annonce créée doit apparaître dans le dashboard");
    });
%}

