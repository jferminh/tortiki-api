### =============================================================
### TORTIKI — Listings (Sprint 1 + fix géolocalisation ville)
### POST   /api/v1/listings         → 201 (ROLE_SELLER)
### GET    /api/v1/listings/cities  → 200 (public) — preuve indirecte du fix city
### GET    /api/v1/listings/search  → 200 (public)
### GET    /api/v1/listings/{id}    → 200 (public)
### PUT    /api/v1/listings/{id}    → 200 (ROLE_SELLER)
### GET    /api/v1/seller-listings  → 200 (ROLE_SELLER, dashboard privé)
### DELETE /api/v1/listings/{id}    → 204 (ROLE_SELLER, soft delete)
### =============================================================

### [1] Login Sofia — SELLER
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{sofiaEmail}}",
  "password": "{{password}}"
}

###

### [2] Sofia crée une annonce à Nancy — reproduit l'adresse exacte du bug NOT NULL sur listings.city
POST {{baseUrl}}/api/v1/listings
Content-Type: application/json

{
  "title": "Bortsch ukrainien maison",
  "description": "Soupe traditionnelle ukrainienne, recette de ma grand-mère",
  "price": 8.50,
  "portions": 4,
  "cuisineTypeId": 1,
  "allergenIds": [],
  "pickupAddress": "2 Allée Lys Rouge, 54000 Nancy",
  "pickupDatetime": "2027-03-15T12:00:00"
}

> {%
    client.test("Créer annonce → 201 ACTIVE", function() {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        const body = response.body;
        client.assert(body["status"] === "ACTIVE", "Statut attendu : ACTIVE");
        client.global.set("listingId", String(body["id"]));
    });
%}

###

### [3] Preuve indirecte du fix : la ville "Nancy" a bien été résolue et persistée
### ListingResponse n'expose pas city — on vérifie via l'autocomplétion,
### qui interroge directement la colonne SQL listings.city.
GET {{baseUrl}}/api/v1/listings/cities

> {%
    client.test("Autocomplétion → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Ville 'Nancy' présente après création — city correctement géocodée", function() {
        const cities = response.body;
        client.assert(cities.includes("Nancy"),
            "Nancy doit apparaître dans les villes actives, reçu : " + JSON.stringify(cities));
    });
%}

###

### [4] Sofia tente de créer une annonce avec une adresse non géolocalisable → 422
### Vérifie AddressNotGeocodableException + le handler GlobalExceptionHandler ajoutés pour ce fix.
POST {{baseUrl}}/api/v1/listings
Content-Type: application/json

{
  "title": "Test adresse invalide",
  "description": "Vérification du handler AddressNotGeocodableException",
  "price": 5.00,
  "portions": 2,
  "cuisineTypeId": 1,
  "allergenIds": [],
  "pickupAddress": "xzqwvt99 inexistant rue impossible, 00000",
  "pickupDatetime": "2027-03-15T12:00:00"
}

> {%
    client.test("Adresse non géolocalisable → 422 Unprocessable Entity", function() {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
    });
    client.test("Le message d'erreur mentionne la géolocalisation", function() {
        const raw = JSON.stringify(response.body);
        client.assert(raw.toLowerCase().includes("g\u00e9olocalisable") || raw.toLowerCase().includes("geolocalisable"),
            "Le corps de réponse devrait mentionner l'échec de géolocalisation, reçu : " + raw);
    });
%}

