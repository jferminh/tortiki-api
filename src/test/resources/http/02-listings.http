### [15] Sofia désactive son annonce → 204 No Content
DELETE {{baseUrl}}/api/v1/listings/7

> {%
    client.test("Désactiver annonce → 204 No Content", function() {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}

###

### [16] Annonce désactivée disparaît de la recherche publique
GET {{baseUrl}}/api/v1/listings/search?city=Strasbourg&page=0&size=10

> {%
    client.test("Annonce INACTIVE absente de la recherche publique", function() {
        const body = response.body;
        const results = body["content"] || body;
        const found = results.some(l => String(l["id"]) === client.global.get("listingId"));
        client.assert(!found, "L'annonce désactivée ne doit plus apparaître en recherche publique");
    });
%}

###

### [17] 'Strasbourg' disparaît de l'autocomplétion après désactivation
### findDistinctActiveCities() filtre sur ListingStatus.ACTIVE — vérifie que
### le filtre de statut s'applique correctement même sur la colonne city.
GET {{baseUrl}}/api/v1/listings/cities

> {%
    client.test("Autocomplétion → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("'Strasbourg' absente — plus aucune annonce ACTIVE dans cette ville", function() {
        const cities = response.body;
        client.assert(!cities.includes("Strasbourg"),
            "Strasbourg ne doit plus apparaître après désactivation, reçu : " + JSON.stringify(cities));
    });
%}

###

### [18] Sofia consulte son dashboard — l'annonce INACTIVE reste visible (200 OK)
GET {{baseUrl}}/api/v1/seller-listings

> {%
    client.test("Dashboard vendeur → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Annonce INACTIVE toujours visible dans le dashboard", function() {
        const body = response.body;
        const listing = body.find(l => String(l["id"]) === client.global.get("listingId"));
        client.assert(listing !== undefined, "L'annonce doit rester dans le dashboard après désactivation");
        client.assert(listing["status"] === "INACTIVE", "Statut attendu : INACTIVE");
    });
%}

