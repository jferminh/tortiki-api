### [9] Login Sofia
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{sofiaEmail}}",
  "password": "{{password}}"
}

###

### [10] Sofia modifie son annonce → 200 OK
PUT {{baseUrl}}/api/v1/listings/{{listingId}}
Content-Type: application/json

{
  "title": "Bortsch ukrainien maison — édition été",
  "description": "Recette estivale avec ingrédients frais du marché.",
  "price": 9.50,
  "portions": 4,
  "cuisineTypeId": 1,
  "allergenIds": [],
  "pickupAddress": "2 Allée Lys Rouge, 54000 Nancy",
  "pickupDatetime": "2026-07-15T12:00:00"
}

> {%
    client.test("Modifier annonce → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        const body = response.body;
        client.assert(body["price"] === 9.50, "Prix attendu : 9.50");
    });
%}

###

### [11] Sofia consulte son dashboard — l'annonce ACTIVE apparaît (200 OK)
GET {{baseUrl}}/api/v1/seller-listings

> {%
    client.test("Dashboard vendeur → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Annonce présente dans le dashboard", function() {
        const body = response.body;
        const found = body.some(l => String(l["id"]) === client.global.get("listingId"));
        client.assert(found, "L'annonce créée doit apparaître dans le dashboard");
    });
%}

###

### [12] Sofia désactive son annonce → 204 No Content
DELETE {{baseUrl}}/api/v1/listings/{{listingId}}

> {%
    client.test("Désactiver annonce → 204 No Content", function() {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}

###

### [13] Annonce désactivée disparaît de la recherche publique
GET {{baseUrl}}/api/v1/listings/search?city=Nancy&page=0&size=10

> {%
    client.test("Annonce INACTIVE absente de la recherche publique", function() {
        const body = response.body;
        const results = body["content"] || body;
        const found = results.some(l => String(l["id"]) === client.global.get("listingId"));
        client.assert(!found, "L'annonce désactivée ne doit plus apparaître en recherche publique");
    });
%}

###

### [14] Sofia consulte son dashboard — l'annonce INACTIVE reste visible (200 OK)
GET {{baseUrl}}/api/v1/seller-listings

> {%
    client.test("Dashboard vendeur → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Annonce INACTIVE toujours visible dans le dashboard", function() {
        const body = response.body;
        const listing = body.find(l => String(l["id"]) === client.global.get("listingId"));
        client.assert(listing !== undefined, "L'annonce doit rester dans le dashboard après désactivation");
        client.assert(listing["status"] === "INACTIVE", "Statut attendu : INACTIVE");
    });
%}

###

### [15] Login second vendeur — Nadia (test IDOR)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{nadiaEmail}}",
  "password": "{{password}}"
}

###

### [16] Nadia consulte son dashboard — ne doit voir aucune annonce de Sofia (200 OK)
GET {{baseUrl}}/api/v1/seller-listings

> {%
    client.test("Dashboard vendeur → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("IDOR — aucune annonce de Sofia visible", function() {
        const body = response.body;
        const leaked = body.some(l => String(l["id"]) === client.global.get("listingId"));
        client.assert(!leaked, "Nadia ne doit jamais voir l'annonce de Sofia (IDOR)");
    });
%}