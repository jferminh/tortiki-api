### [20] Nadia consulte son dashboard — ne doit voir aucune annonce de Sofia (200 OK)
GET {{baseUrl}}/api/v1/seller-listings

> {%
    client.test("Dashboard vendeur → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("IDOR — aucune annonce de Sofia visible", function() {
        const body = response.body;
        const leaked = body.some(l => String(l["id"]) === client.global.get("listingId"));
        client.assert(!leaked, "Nadia ne doit jamais voir l'annonce de Sofia (IDOR)");
    });
%}