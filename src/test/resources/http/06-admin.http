### [9] Sans authentification → 401 Unauthorized
PATCH {{baseUrl}}/api/v1/listings/{{listingId}}/status
Content-Type: application/json

{
  "newStatus": "INACTIVE"
}

> {%
    client.test("PATCH statut sans auth → 401 Unauthorized", function() {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}