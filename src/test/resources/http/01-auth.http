%}

###

### [5] Mauvais mot de passe → 401 Unauthorized
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{sofiaEmail}}",
  "password": "MauvaisMotDePasse99!"
}

> {%
    client.test("Login mauvais mot de passe → 401", function() {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

###

### [6] Logout Sofia → 204 No Content
POST {{baseUrl}}/api/v1/auth/logout

> {%
    client.test("Logout → 204 No Content", function() {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}

### [1] Inscription Admin — ADMIN
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{password}}",
  "firstName": "admin",
  "lastName": "admin",
  "role": "ADMIN"
}

> {%
    client.test("Register Admin → 201 Created", function() {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.body.roles.includes("ADMIN"), "Role ADMIN attendu");
        client.global.set("adminId", response.body.id);
    });
%}