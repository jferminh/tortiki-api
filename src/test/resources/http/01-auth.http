###

### [3] Login Sofia — SELLER (cookie JSESSIONID sauvegardé)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{sofiaEmail}}",
  "password": "{{password}}"
}

> {%
    client.test("Login Sofia → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.firstName === "Sofia", "firstName attendu : Sofia");
        client.assert(response.body.roles.includes("SELLER"), "Role SELLER attendu");
    });
%}

###

### [4] Login Théo — BUYER
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{theoEmail}}",
  "password": "{{password}}"
}

> {%
    client.test("Login Théo → 200 OK", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
