### =============================================================
### TORTIKI — Auth
### POST /api/v1/auth/register  → 201
### POST /api/v1/auth/login     → 200
### POST /api/v1/auth/logout    → 200
### =============================================================

### [1] Inscription Sofia — SELLER
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "{{sofiaEmail}}",
  "password": "{{password}}",
  "firstName": "Sofia",
  "lastName": "Koval",
  "role": "SELLER"
}

> {%
    client.test("Register Sofia → 201 Created", function() {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.body.roles.includes("SELLER"), "Role SELLER attendu");
        client.global.set("sofiaId", response.body.id);
    });
%}

###

